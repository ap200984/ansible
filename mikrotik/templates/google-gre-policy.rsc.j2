{% set records = [
 {'path':'/ip route','comment':'Google GRE default','values':'dst-address=0.0.0.0/0 routing-table=google_ips_table gateway=' ~ google_gre_gateway ~ '%gre-vds6 check-gateway=ping distance=1 disabled=no'},
 {'path':'/ip route','comment':'Google GRE unavailable','values':'blackhole dst-address=0.0.0.0/0 routing-table=google_ips_table distance=254 disabled=no'},
 {'path':'/ip firewall filter','comment':'Google GRE outer input','values':'chain=input action=accept protocol=gre src-address=' ~ google_gre_server_loopback ~ ' dst-address=10.255.0.' ~ google_gre_link.suffix},
 {'path':'/ip firewall filter','comment':'Google GRE outbound','values':'chain=forward action=accept in-interface=LAN out-interface=gre-vds6 dst-address-list=google_ips'},
 {'path':'/ip firewall filter','comment':'Google GRE return forward','values':'chain=forward action=accept in-interface=gre-vds6 connection-state=established,related'},
 {'path':'/ip firewall filter','comment':'Google GRE return input','values':'chain=input action=accept in-interface=gre-vds6 connection-state=established,related'},
 {'path':'/ip firewall nat','comment':'Google GRE source NAT','values':'chain=srcnat action=src-nat out-interface=gre-vds6 dst-address-list=google_ips to-addresses=' ~ google_gre_link.router_address},
 {'path':'/ip firewall mangle','comment':'Google GRE connection LAN','values':'chain=prerouting action=mark-connection in-interface=LAN dst-address-list=google_ips dst-address-type=!local new-connection-mark=google_gre passthrough=yes'},
 {'path':'/ip firewall mangle','comment':'Google GRE routing LAN','values':'chain=prerouting action=mark-routing in-interface=LAN dst-address-list=google_ips dst-address-type=!local new-routing-mark=google_ips_table passthrough=no'},
 {'path':'/ip firewall mangle','comment':'Google GRE connection router','values':'chain=output action=mark-connection dst-address-list=google_ips dst-address-type=!local new-connection-mark=google_gre passthrough=yes'},
 {'path':'/ip firewall mangle','comment':'Google GRE routing router','values':'chain=output action=mark-routing dst-address-list=google_ips dst-address-type=!local new-routing-mark=google_ips_table passthrough=no'}
] %}
{% set checks = namespace(records=[{'path':'/ip firewall address-list','comment':'Google GRE IP check hostname','values':'list=google_gre_ip_check address=' ~ google_gre_check_hostname ~ ' disabled=no'}]) %}
{% for record in records %}
{% if 'dst-address-list=google_ips' in record['values'] %}
{% set checks.records = checks.records + [{'path':record.path,'comment':record.comment | replace('Google GRE', 'Google GRE IP check'),'values':record['values'] | replace('dst-address-list=google_ips', 'dst-address-list=google_gre_ip_check')}] %}
{% endif %}
{% endfor %}
{% for list_name in service_gre_address_lists %}
{% for record in records %}
{% if 'dst-address-list=google_ips' in record['values'] %}
{% set checks.records = checks.records + [{'path':record.path,'comment':record.comment | replace('Google GRE', 'Service GRE ' ~ list_name),'values':record['values'] | replace('dst-address-list=google_ips', 'dst-address-list=' ~ list_name)}] %}
{% endif %}
{% endfor %}
{% endfor %}
{% set records = records + checks.records + [{'path':'/ip firewall address-list','comment':'Service GRE Telegram feed hostname','values':'list=telegram_feed_ips address=core.telegram.org disabled=no'}] %}
{% set records = records + [
 {'path':'/ip firewall mangle','comment':'Service GRE established routing LAN','values':'chain=prerouting action=mark-routing in-interface=LAN connection-mark=google_gre dst-address-type=!local new-routing-mark=google_ips_table passthrough=no'},
 {'path':'/ip firewall mangle','comment':'Service GRE established routing router','values':'chain=output action=mark-routing connection-mark=google_gre dst-address-type=!local new-routing-mark=google_ips_table passthrough=no'},
 {'path':'/ip firewall filter','comment':'Service GRE marked outbound','values':'chain=forward action=accept in-interface=LAN out-interface=gre-vds6 connection-mark=google_gre'}
] %}
{% for record in records %}
:local r{{ loop.index }} [{{ record.path }} find where comment="{{ record.comment }}"];
:if ([:len $r{{ loop.index }}] > 1) do={:error "Duplicate Google GRE rule"};
:if ([:len $r{{ loop.index }}] = 0) do={ {{ record.path }} add comment="{{ record.comment }}" {{ record['values'] }}}
else={ {{ record.path }} set $r{{ loop.index }} {{ record['values'] }}};
{% endfor %}
/ip route disable [find where routing-table=google_ips_table and comment!="Google GRE default" and comment!="Google GRE unavailable"];
/ip firewall mangle disable [find where dst-address-list=google_ips and comment!="Google GRE connection LAN" and comment!="Google GRE routing LAN" and comment!="Google GRE connection router" and comment!="Google GRE routing router"];
{% for list_name in service_gre_address_lists %}
/ip firewall mangle disable [find where dst-address-list={{ list_name }} and comment!="Service GRE {{ list_name }} connection LAN" and comment!="Service GRE {{ list_name }} routing LAN" and comment!="Service GRE {{ list_name }} connection router" and comment!="Service GRE {{ list_name }} routing router"];
{% endfor %}
/ip firewall filter set [find where action=fasttrack-connection and chain=forward] connection-mark=!google_gre;
{% for record in records | reverse %}
{% if record.path in ['/ip firewall filter', '/ip firewall mangle'] %}
:local first{{ loop.index }} [:pick [{{ record.path }} find where dynamic=no] 0];
:local target{{ loop.index }} [{{ record.path }} find where comment="{{ record.comment }}"];
:if ($first{{ loop.index }} != [:pick $target{{ loop.index }} 0]) do={ {{ record.path }} move $target{{ loop.index }} destination=$first{{ loop.index }} };
{% endif %}
{% endfor %}
:put "GOOGLE_GRE_POLICY_READY";
