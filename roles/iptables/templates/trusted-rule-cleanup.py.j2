#!/usr/bin/env python3
"""Normalize the managed INPUT prefix and remove superseded legacy accepts."""
import ipaddress
import shlex
import subprocess

trusted_networks = [ipaddress.ip_network(value) for value in {{ trusted_networks | to_json }}]
trusted_hosts = {
    ipaddress.ip_interface(value).ip for value in {{ trusted_hosts | to_json }}
}
ssh_port = '{{ iptables_input_ssh_port }}'

if subprocess.run(['ipset', 'list', 'Blacklist'], stdout=subprocess.DEVNULL,
                  stderr=subprocess.DEVNULL).returncode != 0:
    subprocess.run(
        ['ipset', 'create', 'Blacklist', 'hash:net', 'family', 'inet',
         'timeout', '{{ ssh_bruteforce_bantime | default(1209600) }}'],
        check=True,
    )

desired = [
    ['-s', '127.0.0.0/8', '-j', 'ACCEPT'],
    ['-m', 'conntrack', '--ctstate', 'RELATED,ESTABLISHED', '-j', 'ACCEPT'],
    ['-m', 'set', '--match-set', 'trusted_hosts', 'src', '-j', 'ACCEPT'],
    ['-m', 'set', '--match-set', 'trusted_networks', 'src', '-j', 'ACCEPT'],
    ['-p', 'tcp', '-m', 'tcp', '--dport', ssh_port,
     '-m', 'set', '--match-set', 'Blacklist', 'src',
     '-m', 'comment', '--comment', 'ansible-ssh-blacklist', '-j', 'DROP'],
    ['-p', 'tcp', '-m', 'tcp', '--dport', ssh_port, '-j', 'ACCEPT'],
]


def run(*args, check=True):
    return subprocess.run(['iptables', *args], check=check,
                          stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL)


def delete(rule):
    run('-D', 'INPUT', *rule)


def is_managed(rule):
    return rule in desired

original_rules = subprocess.check_output(
    ['iptables', '-S', 'INPUT'], text=True
).splitlines()

# Remove every legacy reference before destroying the superseded sets.  The
# canonical trusted_networks/trusted_hosts rules below replace these policies.
for table in ('filter', 'nat', 'mangle', 'raw'):
    output = subprocess.run(
        ['iptables', '-t', table, '-S'], text=True, capture_output=True, check=False
    ).stdout.splitlines()
    for line in output:
        args = shlex.split(line)
        if not args or args[0] != '-A' or '--match-set' not in args:
            continue
        set_name = args[args.index('--match-set') + 1]
        if set_name not in ('allowed_hosts', 'ospf-routed'):
            continue
        chain = args[1]
        run('-t', table, '-D', chain, *args[2:])
        print(f'REMOVED_LEGACY_SET_RULE={table}:{line}')

original_rules = subprocess.check_output(
    ['iptables', '-S', 'INPUT'], text=True
).splitlines()

for line in original_rules:
    args = shlex.split(line)
    if not args or args[0:2] != ['-A', 'INPUT']:
        continue
    rule = args[2:]
    if is_managed(rule):
        delete(rule)
        continue
    if '-s' not in args or '-j' not in args:
        source = None
    else:
        source = ipaddress.ip_network(args[args.index('-s') + 1], strict=False)

    jump = args[args.index('-j') + 1] if '-j' in args else None
    redundant_host_accept = (
        jump == 'ACCEPT' and source is not None and source.version == 4 and
        source.prefixlen == 32 and
        (source.network_address in trusted_hosts or
         any(source.network_address in network for network in trusted_networks))
    )
    legacy_allowed_hosts = (
        jump == 'ACCEPT' and '--match-set' in args and
        args[args.index('--match-set') + 1] == 'allowed_hosts'
    )
    legacy_tcp_56685 = (
        jump == 'ACCEPT' and '-p' in args and args[args.index('-p') + 1] == 'tcp' and
        '--dports' in args and args[args.index('--dports') + 1] == '56685'
    )
    redundant_icmp_drop = (
        jump == 'DROP' and '-p' in args and args[args.index('-p') + 1] == 'icmp' and
        '--icmp-type' in args and args[args.index('--icmp-type') + 1] in ('8', 'echo-request')
    )
    broad_wireguard_accept = (
        jump == 'ACCEPT' and '-p' in args and args[args.index('-p') + 1] == 'udp' and
        '--dport' in args and
        args[args.index('--dport') + 1] == '{{ iptables_input_wireguard_port }}' and
        (source is None or source == ipaddress.ip_network('0.0.0.0/0'))
    )
    broad_ospf_accept = (
        jump == 'ACCEPT' and source == ipaddress.ip_network('10.250.0.0/16') and
        '-p' in args and args[args.index('-p') + 1] in ('89', 'ospf')
    )
    obsolete_public_ports = {'80', '443', '1953', '3000', '5222', '5269', '5280', '5443'}
    redundant_docker_input = (
        jump == 'ACCEPT' and '-p' in args and args[args.index('-p') + 1] == 'tcp' and
        '--dports' in args and
        set(args[args.index('--dports') + 1].split(',')).issubset(obsolete_public_ports)
    )
    if (redundant_host_accept or legacy_allowed_hosts or legacy_tcp_56685 or
            redundant_icmp_drop or broad_wireguard_accept or broad_ospf_accept or
            redundant_docker_input):
        delete(rule)
        print(f'REMOVED_LEGACY_INPUT_RULE={line}')
        continue

    # Docker-published ports are DNATed before filtering and traverse FORWARD.
    # Keep only genuine host-local ports from a mixed legacy multiport rule.
    if (jump == 'ACCEPT' and '-p' in args and args[args.index('-p') + 1] == 'tcp' and
            '--dports' in args):
        ports_index = rule.index('--dports') + 1
        ports = rule[ports_index].split(',')
        remaining = [port for port in ports
                     if port != ssh_port and port not in obsolete_public_ports]
        if remaining != ports:
            delete(rule)
            if remaining:
                rule[ports_index] = ','.join(dict.fromkeys(remaining))
                run('-A', 'INPUT', *rule)
            print(f'COMPACTED_PUBLIC_SERVICE_RULE={line}')

# Inserting the block in reverse produces the requested order at positions 1-6.
for rule in reversed(desired):
    run('-I', 'INPUT', '1', *rule)

for set_name in ('allowed_hosts', 'ospf-routed'):
    subprocess.run(['ipset', 'destroy', set_name], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

