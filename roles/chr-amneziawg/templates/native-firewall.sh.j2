#!/bin/sh
set -eu
iptables -C INPUT -s {{ chr_awg_public_endpoint }}/32 -p udp --dport 56707 -m comment --comment chr-native-awg -j ACCEPT 2>/dev/null ||
  iptables -I INPUT 1 -s {{ chr_awg_public_endpoint }}/32 -p udp --dport 56707 -m comment --comment chr-native-awg -j ACCEPT
iptables -C INPUT -i wg2 -s 10.250.1.7/32 -p ospf -j ACCEPT 2>/dev/null ||
  iptables -I INPUT 1 -i wg2 -s 10.250.1.7/32 -p ospf -j ACCEPT
iptables -C OUTPUT -o wg2 -d 224.0.0.5/32 -p ospf -j ACCEPT 2>/dev/null ||
  iptables -I OUTPUT 1 -o wg2 -d 224.0.0.5/32 -p ospf -j ACCEPT
