[Unit]
Description=Firewall permits for OSPF over existing WireGuard
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target netfilter-persistent.service
Wants=network-pre.target
Before=frr.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ospf-firewall
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
