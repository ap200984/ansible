#!/usr/bin/env python3
import shlex
import subprocess

name = '{{ ssh_bruteforce_ipset }}'
bantime = '{{ ssh_bruteforce_bantime }}'

probe = subprocess.run(['ipset', 'list', name], text=True, capture_output=True)
if probe.returncode != 0:
    subprocess.run(['ipset', 'create', name, 'hash:net', 'family', 'inet',
                    'timeout', bantime], check=True)
    print('CHANGED_CREATED')
    raise SystemExit(0)
if 'Type: hash:net' in probe.stdout:
    print('OK_HASH_NET')
    raise SystemExit(0)
if 'Type: hash:ip' not in probe.stdout:
    raise SystemExit('Unsupported ipset type for ' + name)

subprocess.run(['systemctl', 'stop', 'fail2ban'], check=False)
saved = subprocess.check_output(['ipset', 'save', name], text=True).splitlines()
for line in subprocess.check_output(['iptables', '-S', 'INPUT'], text=True).splitlines():
    args = shlex.split(line)
    if args[:2] == ['-A', 'INPUT'] and '--match-set' in args and name in args:
        subprocess.run(['iptables', '-D', 'INPUT', *args[2:]], check=True)

temporary = name + '_net_migration'
subprocess.run(['ipset', 'destroy', temporary], check=False,
               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
subprocess.run(['ipset', 'create', temporary, 'hash:net', 'family', 'inet',
                'timeout', bantime], check=True)
for line in saved:
    args = shlex.split(line)
    if args[:2] != ['add', name]:
        continue
    args[1] = temporary
    subprocess.run(['ipset', *args], check=True)
subprocess.run(['ipset', 'destroy', name], check=True)
subprocess.run(['ipset', 'rename', temporary, name], check=True)
print('CHANGED_MIGRATED')
